# Copy to .env and fill in. .env is gitignored — keep real secrets out of git.
# Production should set real environment variables instead of shipping this file.

# Who can approve photos. Comma-separated. Without this nobody can review, and
# no photo ever goes live.
ADMIN_EMAILS=you@example.com

# Stable logins across restarts. openssl rand -hex 32
SESSION_SECRET=

# Encrypts stored photos. Exactly 64 hex chars: openssl rand -hex 32
# In production keep this OUTSIDE the data directory — a backup that carries
# its own key is not meaningfully encrypted. Lose it and every photo is gone.
PHOTO_KEY=

# Optional
# PORT=3000
# DATA_DIR=./data
# PHOTO_HOURLY_BUDGET=400
